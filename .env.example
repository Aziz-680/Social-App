# Copy to .env for local use, or set these in your deployment platform's secret manager.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/social_app

# Use unique, random values. ENCRYPTION_KEY must be exactly 32 UTF-8 bytes;
# each JWT secret must be at least 32 bytes.
ENCRYPTION_KEY=
USER_ACCESS_SECRET=
USER_REFRESH_SECRET=
ADMIN_ACCESS_SECRET=
ADMIN_REFRESH_SECRET=

# Comma-separated browser origins. Required in production.
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY_HOPS=0

# Required for image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only if Google sign-in is enabled.
GOOGLE_CLIENT_ID=